# Laravel Environment Configuration Example
#
# Copy this file to .env and fill in real values. Never commit .env.
# For production: keep APP_ENV=production, APP_DEBUG=false, LOG_LEVEL=error,
# and serve the app over HTTPS (APP_URL=https://...).

APP_NAME=Laravel
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=starradius
DB_USERNAME=starradius
DB_PASSWORD=YOUR_DATABASE_PASSWORD_HERE

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

TIMEZONE=Asia/Makassar
CURRENCY=IDR
